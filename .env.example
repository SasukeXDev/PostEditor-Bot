# Telegram bot used for commands and opening the Mini App
BOT_TOKEN=123456:replace_me
BOT_USERNAME=YourRecoveryBot
WEBAPP_URL=https://your-app.example.com

# MTProto user account. Generate SESSION_STRING with the included helper.
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=replace_me
TELEGRAM_SESSION_STRING=

# MongoDB Atlas connection string and database
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=telegram_recovery

# Telegram numeric user IDs allowed to operate the dashboard
ADMIN_USER_IDS=123456789

# Optional: comma-separated channel usernames/IDs to automatically monitor.
# Examples: @mychannel,-1001234567890
MONITOR_CHANNELS=

# App settings
HOST=0.0.0.0
PORT=8000
ROLE=all
LOG_LEVEL=INFO
MAX_SCAN_MESSAGES_PER_CHANNEL=0
WORKER_POLL_SECONDS=2
EDIT_DELAY_SECONDS=1.0
